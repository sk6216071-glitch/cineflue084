# CiNEPHiLE Rust API Environment Variables (Example Template)
# DO NOT COMMIT REAL CREDENTIALS. COPY TO .env FOR LOCAL DEVELOPMENT.

# Server Configuration (Use 0.0.0.0 when running inside Docker container)
PORT=8080
HOST=0.0.0.0
RUST_LOG=info,cinephile_rust_api=debug

# Security & Admin Authentication
ADMIN_SECRET_KEY=your_admin_secret_key_here
ADMIN_PASSWORD=your_admin_password_here
ADMIN_EMAILS=admin@example.com

# Authoritative MongoDB Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=cinefuel

# Upstash Redis Cache & Rate Limiting
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=cinephile-staging-media
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media-staging.cinephile.example.com

# External Integrations
FIREBASE_PROJECT_ID=cinefuel-app
TMDB_API_KEY=your_tmdb_api_key_v3
