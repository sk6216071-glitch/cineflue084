# CiNEPHiLE Benchmark Environment Variables (Template)
# DO NOT COMMIT REAL CREDENTIALS. USE ISOLATED STAGING OR LOCAL RESOURCES ONLY.

# Target Endpoints
NEXT_LOCAL_URL=http://127.0.0.1:3000
RUST_LOCAL_URL=http://127.0.0.1:8080

# Isolated Benchmark Databases (NEVER USE PRODUCTION)
MONGODB_BENCHMARK_URI=mongodb://127.0.0.1:27017/cinephile_benchmark
REDIS_BENCHMARK_URL=redis://127.0.0.1:6379

# Isolated Benchmark Cloudflare R2 Bucket (NEVER USE PRODUCTION BUCKET)
R2_BENCHMARK_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BENCHMARK_BUCKET=cinephile-benchmark-bucket
R2_BENCHMARK_ACCESS_KEY=your_benchmark_access_key
R2_BENCHMARK_SECRET_KEY=your_benchmark_secret_key
